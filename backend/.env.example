# Copy to backend/.env and fill in. The app reads these via app/config.py.
# (See README "Run locally". You chose live-keys-required; all three are needed for a full run.)

# --- Data layer ---
# Local dev points at the docker-compose Postgres. Prod: swap for the Cloud SQL URL.
DATABASE_URL=postgresql://gpve:gpve@localhost:5432/gpve

# Web-reputation cache. Leave blank for the local JSON-file cache (dev). In production set to
# the Memorystore endpoint, e.g. redis://10.x.x.x:6379 (reachable via the VPC connector).
REDIS_URL=

# --- LLM + embeddings: Gemini (https://aistudio.google.com/apikey) ---
# NOTE: the Gemini API needs free-tier access or credits on the project — a key alone isn't
# enough if the project is on prepay billing with no credits (429 RESOURCE_EXHAUSTED).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# --- Catalog enrichment + cover art: RAWG (https://rawg.io/apidocs) ---
RAWG_API_KEY=

# --- Live web reputation: Tavily (https://app.tavily.com) ---
TAVILY_API_KEY=

# --- Ingestion paths ---
CSV_PATH=../data/Gamepass_Games_v1.csv
ENRICHMENT_CACHE_PATH=../data/enrichment_cache.json
