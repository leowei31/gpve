# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored (it holds secrets).
# Alternatively export TF_VAR_gemini_api_key=... etc. to keep keys out of files entirely.

project_id = "your-gcp-project-id"
region     = "us-central1"

# Image to deploy. Build + push first (see infra/README.md), then set the tag (e.g. a git SHA).
image_tag = "latest"

# --- Secrets (required for a working deploy) ---
gemini_api_key = "AIza..."
rawg_api_key   = "..."
tavily_api_key = "tvly-..."

# --- Optional knobs ---
# db_tier               = "db-f1-micro"   # cheapest; bump for real load
# min_instances         = 0               # 1 keeps a warm instance (no cold starts, more cost)
# allow_unauthenticated = true            # false = IAM-gated service
# db_public_ip          = true            # false = private-only (seed via the Cloud Run Job)

# --- Optional CI (needs the repo connected to Cloud Build's GitHub app) ---
# enable_ci_trigger = true
# github_owner      = "your-gh-user"
# github_repo       = "gpve"
# github_branch     = "^main$"
